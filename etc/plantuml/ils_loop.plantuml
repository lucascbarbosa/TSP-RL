' etc/plantuml/ils_loop.plantuml
' Loop do QL-ILS: agente decide par (perturbação, busca local)
@startuml

skinparam Dpi 300
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 15
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 8

skinparam activity {
  BackgroundColor #E8F5E9
  BorderColor #006446
  FontColor #1B5E20
  DiamondBackgroundColor #FFF3E0
  DiamondBorderColor #E65100
  DiamondFontColor #E65100
}

skinparam ArrowColor #006446
skinparam ArrowThickness 2

title Loop do QL-ILS

start

:Gerar solução inicial
(construtivo aleatório);

:Aplicar 2-opt;

:best ← solução atual
i ← 0;

repeat
  :Observar estado s
  (gap da solução atual);

  :Consultar Q-table:
  a = argmax Q(s, a);

  note right
    Ação a = (Pert, BL)
    ──────────────────
    **Perturbações leves:**
    • two_swap
    • segment_reverse
    **Perturbações destrutivas:**
    • random (construtivo)
    • nearest (construtivo)
    • cheapest (construtivo)
    ──────────────────
    **Buscas Locais:**
    • 2-opt
    • Lin-Kernighan
  end note

  :Aplicar perturbação;

  :Aplicar busca local;

  if (custo < best.custo?) then (sim)
    :best ← nova solução;
    :i ← 0;
  else (não)
    :i ← i + 1;
  endif

  :solução atual ← nova solução;
  note right
    ILS sempre continua
    da nova solução
  end note

repeat while (i < max_iter?) is (sim)
->não;

:Retornar best;

stop

@enduml
