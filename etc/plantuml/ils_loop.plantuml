' etc/plantuml/ils_loop.plantuml
' Loop do Q-ILS: agente decide par (perturbação, busca local)
@startuml

skinparam Dpi 300
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 15
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 8

skinparam activity {
  BackgroundColor #E8F5E9
  BorderColor #006446
  FontColor #1B5E20
  DiamondBackgroundColor #FFF3E0
  DiamondBorderColor #E65100
  DiamondFontColor #E65100
}

skinparam ArrowColor #006446
skinparam ArrowThickness 2

title Loop do Q-ILS

start

:Gerar s₀ (Construtivo);

:Busca local inicial (3-opt);

:best ← s₀;

repeat
  :Observar estado s (gap);

  :Consultar Q-table:
  a = argmax Q(s, a);

  note right
    Ação a = (Pert, BL)
    ──────────────────
    **Perturbações:**
    • two_swap
    • segment_reverse
    • random (construtivo)
    • nearest (construtivo)
    • cheapest (construtivo)
    ──────────────────
    **Buscas Locais:**
    • 2-opt
    • 3-opt
    • Lin-Kernighan
  end note

  :Aplicar perturbação;

  :Aplicar busca local;

  if (custo < best?) then (sim)
    :best ← s;
    :i ← 0;
  else (não)
    :i++;
  endif

repeat while (i < max?) is (sim)
->não;

:Retornar best;

stop

@enduml
